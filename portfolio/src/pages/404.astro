---
import Layout from "@/layouts/Layout.astro";
import WebGLEye from "@/components/WebGLEye";
// Static hosting serves this generated 404.html with its own 404 response.
---

<Layout title="Page not found · Miguel García" skipIntro>
  <section class="max-w-3xl mx-auto px-6 pt-32 pb-12 text-center">
    <p class="text-xs text-muted-foreground mb-3">404</p>
    <h1 class="font-serif text-4xl mb-4">A little out of focus</h1>
    <p class="text-muted-foreground mb-6">This page could not be found. Follow the eye home, or head back now.</p>
    <a href="/" class="inline-block px-5 py-3 border border-border rounded-md hover:bg-muted focus-visible:outline-2 focus-visible:outline-primary">Go home</a>
    <WebGLEye mode="auto" destination="/" client:only="react" />
  </section>
</Layout>
