---
import { render } from "astro:content";
import BlogLink from "@/components/blog/BlogLink.astro";
import { getVisiblePosts } from "@/lib/blog";
import BlogLayout from "@/layouts/BlogLayout.astro";

export async function getStaticPaths() {
	const posts = (await getVisiblePosts())
		.filter((p) => !p.data.lang || p.data.lang === "en")
		// Undated drafts follow published articles in private previews.
		.sort((a, b) => {
			const aDate = a.data.date ? new Date(a.data.date).valueOf() : Number.MAX_SAFE_INTEGER;
			const bDate = b.data.date ? new Date(b.data.date).valueOf() : Number.MAX_SAFE_INTEGER;
			return aDate - bDate || a.id.localeCompare(b.id);
		});

	return posts.map((post, i) => {
		const previous = posts[i - 1];
		const next = posts[i + 1];
		return {
			params: { slug: post.id },
			props: {
				post,
				prevUrl: previous ? `/blog/${previous.id}` : null,
				nextUrl: next ? `/blog/${next.id}` : null,
			},
		};
	});
}

const { post, prevUrl, nextUrl } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout frontmatter={post.data} prevUrl={prevUrl} nextUrl={nextUrl} id={post.id}>
  <Content components={{ a: BlogLink }} />
</BlogLayout>
