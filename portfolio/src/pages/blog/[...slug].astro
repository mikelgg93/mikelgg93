---
import { getCollection, render } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";

export async function getStaticPaths() {
	const posts = (await getCollection("blog"))
		.filter((p) => !p.data.lang || p.data.lang === "en")
		.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());

	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			prevUrl: i > 0 ? `/blog/${posts[i - 1].id}` : null,
			nextUrl: i < posts.length - 1 ? `/blog/${posts[i + 1].id}` : null,
		},
	}));
}

const { post, prevUrl, nextUrl } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout frontmatter={post.data} prevUrl={prevUrl} nextUrl={nextUrl}>
  <Content />
</BlogLayout>
