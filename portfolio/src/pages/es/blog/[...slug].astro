---
import { render } from "astro:content";
import BlogLink from "@/components/blog/BlogLink.astro";
import { getVisiblePosts } from "@/lib/blog";
import BlogLayout from "@/layouts/BlogLayout.astro";

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return posts
		.filter((p) => p.data.lang === "es")
		.map((post) => ({
			params: { slug: post.id.replace("-es", "") },
			props: { post },
		}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BlogLayout frontmatter={post.data} id={post.id}>
  <Content components={{ a: BlogLink }} />
</BlogLayout>
