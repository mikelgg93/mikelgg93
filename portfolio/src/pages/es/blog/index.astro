---
import BlogPostList from "@/components/BlogPostList.astro";
import { getVisiblePosts } from "@/lib/blog";
import Layout from "@/layouts/Layout.astro";

const posts = await getVisiblePosts();

const sortedPosts = posts
	.filter((p) => p.data.lang === "es")
	.sort(
		(a, b) =>
			new Date(b.data.date || 0).valueOf() -
			new Date(a.data.date || 0).valueOf(),
	);
---

<Layout title="Blog" description="Pensamientos sobre optometría, neurociencia y código.">
  <section class="container mx-auto px-4 md:px-8 pt-24 pb-12 md:py-28 max-w-5xl">
    <header class="pb-8 md:pb-10 border-b border-border/50">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight font-serif">Blog</h1>
      <p class="mt-4 text-lg md:text-xl text-muted-foreground leading-relaxed max-w-2xl">
        Escribiendo sobre mi viaje en investigación y desarrollo.
      </p>
    </header>
    <BlogPostList posts={sortedPosts} lang="es" />
  </section>
</Layout>
