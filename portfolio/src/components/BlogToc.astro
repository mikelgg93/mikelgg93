---
// A margin table of contents that starts aligned with the article title and
// follows along as you scroll, highlighting the current section. It lives
// inside <article> (its positioning context) so it never floats over the
// banner, and sits in the right margin on wide screens only.
---
<aside
  id="blog-toc"
  aria-label="Table of contents"
  class="not-prose hidden xl:block absolute left-full inset-y-0 ml-6 w-52"
>
  <nav class="sticky top-28 text-sm">
    <p class="text-[10px] uppercase tracking-wider font-bold text-muted-foreground mb-3">On this page</p>
    <ul id="blog-toc-list" class="flex flex-col gap-2 border-l border-border list-none pl-0 m-0"></ul>
  </nav>
</aside>

<script>
  function slugify(text: string) {
    return text.toLowerCase().trim().replace(/[^\w\s-]/g, "").replace(/\s+/g, "-");
  }

  function setupToc() {
    const aside = document.getElementById("blog-toc");
    const list = document.getElementById("blog-toc-list");
    const article = document.querySelector("article");
    if (!aside || !list || !article) return;

    const headings = Array.from(article.querySelectorAll("h2")) as HTMLElement[];
    if (headings.length === 0) {
      aside.style.display = "none";
      return;
    }

    list.innerHTML = "";
    const links = new Map<string, HTMLAnchorElement>();

    // Read the label without the hidden KaTeX MathML copy, so a heading with
    // inline math does not show duplicated text (e.g. "QQ") in the ToC.
    const labelOf = (h: HTMLElement) => {
      const clone = h.cloneNode(true) as HTMLElement;
      clone.querySelectorAll(".katex-mathml").forEach((n) => n.remove());
      return (clone.textContent || "").trim();
    };

    headings.forEach((h) => {
      const label = labelOf(h);
      if (!h.id) h.id = slugify(label);
      const li = document.createElement("li");
      li.className = "m-0 p-0";
      const a = document.createElement("a");
      a.href = `#${h.id}`;
      a.textContent = label;
      a.className =
        "block -ml-px border-l-2 border-transparent pl-3 no-underline text-muted-foreground hover:text-foreground transition-colors leading-snug";
      a.addEventListener("click", (e) => {
        e.preventDefault();
        h.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", `#${h.id}`);
      });
      li.appendChild(a);
      list.appendChild(li);
      links.set(h.id, a);
    });

    const setActive = (id: string) => {
      links.forEach((a, key) => {
        const on = key === id;
        a.classList.toggle("text-foreground", on);
        a.classList.toggle("font-semibold", on);
        a.classList.toggle("border-primary", on);
        a.classList.toggle("text-muted-foreground", !on);
        a.classList.toggle("border-transparent", !on);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((en) => en.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive((visible[0].target as HTMLElement).id);
      },
      { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
    );
    headings.forEach((h) => observer.observe(h));
    setActive(headings[0].id);
  }

  setupToc();
  document.addEventListener("astro:page-load", setupToc);
</script>
