---
import { sourceUrl } from './sourcePath';
interface Props {
  files: { path: string; code: string; lang: 'ts' | 'tsx' | 'css' }[];
  lang?: 'en' | 'es';
}
const { files, lang = 'en' } = Astro.props;
const es = lang === 'es';
---
<source-files data-loading={es ? "Cargando…" : "Loading…"} data-load-failed={es ? "No se pudo cargar; abre el archivo o vuelve a desplegarlo." : "Could not load; open the file or close and reopen it to retry."} data-copied={es ? 'Copiado' : 'Copied'} data-failed={es ? 'No se pudo copiar; selecciona el código.' : 'Copy failed; select the code instead.'}>
  <p class="source-intro">{es ? 'Cada bloque es un archivo independiente. Conserva estas rutas bajo src/components/; se incluyen los módulos compartidos y los estilos.' : 'Each block is a separate file. Keep these paths under src/components/; shared modules and styles are included.'}</p>
  {files.map((file, i) => (
    <details open={i === 0} data-source-url={sourceUrl(file.path)}>
      <summary>{file.path}</summary>
      <div class="source-actions">
        <button type="button" disabled data-copy-source aria-label={`${es ? 'Copiar' : 'Copy'} ${file.path}`}>{es ? 'Copiar archivo' : 'Copy file'}</button>
        <a href={sourceUrl(file.path)} data-astro-reload>{es ? "Abrir archivo" : "Open file"}</a>
        <span role="status"></span>
      </div>
      <div class="source-code"></div>
    </details>
  ))}
</source-files>
<script>
  class SourceFiles extends HTMLElement {
    private observer?: IntersectionObserver;
    private controller?: AbortController;
    private load = async (file: HTMLDetailsElement) => {
      if (!file.open || file.querySelector('pre') || file.dataset.loading) return;
      const url = file.dataset.sourceUrl, status = file.querySelector('[role="status"]');
      if (!url || !status) return;
      file.dataset.loading = 'true';
      status.textContent = this.dataset.loading ?? 'Loading…';
      try {
        const response = await fetch(url, { signal: this.controller?.signal });
        if (!response.ok) throw new Error('Source unavailable');
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const pre = html.querySelector('pre');
        if (!pre) throw new Error('Missing source');
        if (!this.isConnected) return;
        file.querySelector('.source-code')?.replaceChildren(pre);
        const button = file.querySelector<HTMLButtonElement>('[data-copy-source]');
        if (button) button.disabled = false;
        status.textContent = '';
      } catch (error) {
        if (this.isConnected && !(error instanceof DOMException && error.name === 'AbortError'))
          status.textContent = this.dataset.loadFailed ?? 'Could not load source';
      } finally { delete file.dataset.loading; }
    };
    private toggle = (event: Event) => {
      if (event.target instanceof HTMLDetailsElement) void this.load(event.target);
    };
    private copy = async (event: Event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-source]');
      if (!button || !this.contains(button)) return;
      const file = button.closest('details');
      const code = file?.querySelector('code')?.textContent;
      const status = file?.querySelector('[role="status"]');
      if (!code || !status) return;
      try {
        await navigator.clipboard.writeText(code);
        if (this.isConnected) status.textContent = this.dataset.copied ?? 'Copied';
      } catch {
        if (this.isConnected) status.textContent = this.dataset.failed ?? 'Copy failed';
      }
    };
    connectedCallback() {
      this.controller = new AbortController();
      this.addEventListener('click', this.copy);
      this.addEventListener('toggle', this.toggle, true);
      this.observer = new IntersectionObserver(entries => {
        for (const entry of entries) if (entry.isIntersecting) void this.load(entry.target as HTMLDetailsElement);
      });
      this.querySelectorAll('details').forEach(file => this.observer?.observe(file));
    }
    disconnectedCallback() {
      this.removeEventListener('click', this.copy);
      this.removeEventListener('toggle', this.toggle, true);
      this.observer?.disconnect();
      this.controller?.abort();
    }
  }
  if (!customElements.get('source-files')) customElements.define('source-files', SourceFiles);
</script>
<style>
  source-files { display: block; background: #24292e; color: #e1e4e8; }
  .source-intro { padding: 16px; margin: 0; font: 14px/1.5 system-ui, sans-serif; }
  details { border-top: 1px solid #59636d; }
  summary { padding: 12px 16px; min-height: 44px; overflow-wrap: anywhere; cursor: pointer; font-family: monospace; }
  .source-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding: 0 16px 8px; font-size: 13px; }
  button { min-height: 44px; padding: 8px 12px; color: #fff; background: #455a64; border: 1px solid #9db0b7; border-radius: 6px; cursor: pointer; }
  button:disabled { opacity: 0.55; cursor: wait; }
  a { color: #b7e6dd; text-decoration: underline; }
  button:focus-visible, summary:focus-visible { outline: 2px solid #8ee6d1; outline-offset: -2px; }
</style>
