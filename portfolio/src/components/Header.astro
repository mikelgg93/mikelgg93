---
import { getVisiblePosts } from "@/lib/blog";
import ThemeToggle from "@/components/ThemeToggle";
import LanguageToggle from "@/components/LanguageToggle";
import MobileMenu from "@/components/MobileMenu";

const pathname = Astro.url.pathname;
const isEs = pathname.startsWith("/es");
const blogPath = isEs ? "/es/blog" : "/blog";
const homePath = isEs ? "/es" : "/";

const allPosts = await getVisiblePosts();
const posts = allPosts
  .filter((p) =>
    isEs ? p.data.lang === "es" : !p.data.lang || p.data.lang === "en",
  )
  .sort(
    (a, b) =>
      new Date(b.data.date || 0).valueOf() -
      new Date(a.data.date || 0).valueOf(),
  )
  .slice(0, 5)
  .map((p) => ({
    title: p.data.title,
    url: isEs ? `/es/blog/${p.id.replace("-es", "")}` : `/blog/${p.id}`,
  }));
---

<nav
  id="main-header"
  class="fixed top-0 w-full z-50 transition-all duration-300 bg-transparent border-b border-transparent"
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div
    class="flex justify-between items-center px-4 md:px-6 py-2 max-w-screen-2xl mx-auto relative z-50"
  >
    <a
      href={homePath}
      class="text-lg font-bold text-primary uppercase tracking-widest font-serif dark:text-white drop-shadow-md"
    >
      MGG
    </a>

    <div class="hidden md:flex items-center gap-1 md:gap-2">
      <div
        class="flex gap-1 md:gap-2 font-serif font-semibold tracking-tight items-center"
      >
        <a
          class="text-primary hover:opacity-70 transition-opacity dark:text-white drop-shadow-md uppercase tracking-wider text-sm px-2"
          href={blogPath}>Blog</a
        >
        <LanguageToggle client:load />
        <ThemeToggle client:load />
      </div>
    </div>

    <div class="md:hidden flex items-center">
      <MobileMenu
        homePath={homePath}
        blogPath={blogPath}
        posts={posts}
        isEs={isEs}
        client:load
      />
    </div>
  </div>
</nav>

<script>
  let cleanupHeader: (() => void) | undefined;

  function initHeader() {
    cleanupHeader?.();
    const header = document.getElementById("main-header");
    if (!header) return;
    const isIos = /iPad|iPhone|iPod/.test(navigator.userAgent) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    document.documentElement.toggleAttribute("data-ios", isIos);

    const handleScroll = () => {
      if (window.scrollY > 50) {
        header.classList.remove("bg-transparent", "border-transparent", "py-2");
        header.classList.add(
          "bg-background/80",
          "backdrop-blur-md",
          "border-border/40",
          "py-1",
          "is-scrolled",
        );
      } else {
        header.classList.add("bg-transparent", "border-transparent", "py-2");
        header.classList.remove(
          "bg-background/80",
          "backdrop-blur-md",
          "border-border/40",
          "py-1",
          "is-scrolled",
        );
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();
    cleanupHeader = () => window.removeEventListener("scroll", handleScroll);
  }

  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("astro:before-swap", () => cleanupHeader?.());
</script>

<style is:global>
  body:has([data-mobile-menu][data-state="open"]) .reading-time {
    visibility: hidden;
  }

  /* viewport-fit=cover exposes the iOS safe area. Use an opaque scrolled
     header there so text cannot show through behind the clock. The extra
     background above it covers the top edge during toolbar transitions. */
  :root[data-ios] #main-header.is-scrolled {
    background-color: var(--background);
  }
  :root[data-ios] {
    background-color: var(--background);
  }
  :root[data-ios] #main-header::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: env(safe-area-inset-top, 0px);
    background: var(--background);
    pointer-events: none;
  }

  #main-header:not(.is-scrolled).header-theme-dark {
    --primary: 0 0% 100%;
    color: white;
  }
  #main-header:not(.is-scrolled).header-theme-dark a,
  #main-header:not(.is-scrolled).header-theme-dark button {
    color: white !important;
  }

  #main-header:not(.is-scrolled).header-theme-light {
    --primary: 169.9 100% 15.1%;
    color: hsl(169.9 100% 15.1%);
  }
  #main-header:not(.is-scrolled).header-theme-light a,
  #main-header:not(.is-scrolled).header-theme-light button {
    color: hsl(169.9 100% 15.1%) !important;
  }
</style>
