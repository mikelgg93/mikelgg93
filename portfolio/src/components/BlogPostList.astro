---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  posts: CollectionEntry<"blog">[];
  lang: "en" | "es";
}

const { posts, lang } = Astro.props;
const isEs = lang === "es";
---

<div class="divide-y divide-border/50">
  {posts.map((post, index) => {
    const href = isEs ? `/es/blog/${post.id.replace(/-es$/, "")}` : `/blog/${post.id}`;
    const date = post.data.date ? new Date(post.data.date) : null;
    const minutes = Math.max(1, Math.ceil((post.body || "").split(/\s+/).length / 200));

    return (
      <article class="py-8 md:py-10">
        <a
          href={href}
          class={`group grid gap-6 md:gap-10 items-center focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-tertiary ${post.data.image ? "sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]" : ""}`}
        >
          {post.data.image && (
            <Image
              src={post.data.image}
              alt=""
              width={1200}
              height={630}
              class="w-full aspect-[1200/630] object-cover"
              loading={index === 0 ? "eager" : "lazy"}
            />
          )}
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-muted-foreground mb-3">
              {date && (
                <time datetime={date.toISOString()}>
                  {date.toLocaleDateString(isEs ? "es-ES" : "en-US", {
                    year: "numeric", month: "short", day: "numeric",
                  })}
                </time>
              )}
              <span>{minutes} {isEs ? "min de lectura" : "min read"}</span>
            </div>
            <h2 class="text-2xl md:text-3xl font-serif font-bold leading-tight text-foreground group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="mt-4 text-base text-muted-foreground leading-relaxed">
                {post.data.description}
              </p>
            )}
          </div>
        </a>
      </article>
    );
  })}
</div>
